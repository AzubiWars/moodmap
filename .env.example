# mock | supabase  (Default: mock – läuft ohne Backend)
VITE_DATA_MODE=mock
# Lokal (`npm run db:start`): http://127.0.0.1:54321 + anon key aus der Ausgabe von `npm run supabase -- status`.
# Gehostet: URL + anon/publishable Key bekommt ihr von den Menschen (nie committen, nie in Issues posten).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Mindestanzahl Antworten pro angezeigter Zelle (docs/PRIVACY.md)
VITE_K_MIN=10
# Nur für die Supabase-CLI (`db push` ins gehostete Projekt), nie mit VITE_-Präfix:
# SUPABASE_DB_PASSWORD=
# Nur serverseitig (Supabase Edge Function Secret), NIE im Frontend:
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini
# APP_URL=https://moodmap-cyan.vercel.app
# PITCH_RESET_PIN= (mindestens 8 Zeichen, zufälligen langen Wert als Supabase-Secret setzen)
# SUPABASE_SERVICE_ROLE_KEY= (nur serverseitig; Edge-Runtime stellt ihn bereit, nie VITE_)
