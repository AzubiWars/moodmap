{
  "id": "beispiel-aggregate",
  "version": 1,
  "granularity": "aggregate",
  "columns": {
    "level": {
      "column": "Ebene",
      "values": { "Land": "nrw", "Bezirk": "regbez", "Kreis": "kreis", "Schule": "school" }
    },
    "region": { "column": "Region" },
    "topic": {
      "column": "Thema",
      "values": { "Gesamt": "all", "Stress": "stress", "Mitsprache": "voice", "Sicherheit": "safety" }
    },
    "wave": { "column": "Welle" },
    "n": { "column": "Anzahl" },
    "score": { "column": "Mittelwert", "scale": { "min": 1, "max": 5 } },
    "distribution": ["S1", "S2", "S3", "S4", "S5"]
  }
}
